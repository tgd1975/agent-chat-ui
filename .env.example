# --- Point the Claude Agent SDK at the LiteLLM proxy (Anthropic-compatible) ---
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_AUTH_TOKEN=sk-litellm-master-key   # must match litellm master_key

# --- Which LiteLLM route to use (a model_name from litellm.config.yaml) ---
AGENT_MODEL=claude-default

# --- GitHub Models (set AGENT_MODEL=github; used by `docker compose up`) ---
# Fine-grained GitHub Personal Access Token with the "Models" permission.
GITHUB_API_KEY=github_pat_...

# --- Provider keys used by LiteLLM (only the ones you actually route to) ---
ANTHROPIC_API_KEY=sk-ant-...
FARM_API_KEY=...

# --- Azure OpenAI (set AGENT_MODEL=copilot to route here) ---
AZURE_API_KEY=...
AZURE_API_BASE=https://your-azure-endpoint.openai.azure.com
AZURE_API_VERSION=2024-10-21
AZURE_DEPLOYMENT=chat            # deployment name; must match azure/<name> in litellm.config.yaml
